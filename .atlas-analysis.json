  "keyFeatures": [
    "Branches — private and group chats with real-time messaging, replies, and file attachments",
    "Picnics — public/community channels with posts, comments, pinned messages, and anonymous authorship",
    "Voice calls — in-branch audio calls with mic toggle and screen sharing support",
    "Real-time updates via Socket.IO for messages, reactions, presence, and calls",
    "Friends system — send/accept/decline friend requests, block users",
    "Reactions — emoji reactions on both Branch and Picnic messages",
    "GIF search and attachment powered by Giphy",
    "CDN file uploads for avatars, branch attachments, and picnic media",
    "Email-verified login with 2FA-style one-time codes",
    "Per-route rate limiting to protect API endpoints"
  ],
